# Copie este arquivo para .env e preencha. No Render, as mesmas variáveis vão em Environment.
# Só SECRET_KEY e DATABASE_URL são obrigatórias para rodar; o resto liga recursos opcionais.
# Nunca envie o .env para o GitHub (ele já está no .gitignore).

# ---------- Básico ----------
# Chave secreta (sessões e links de e-mail). Gere uma longa, ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Não troque à toa: desconecta todo mundo e invalida os links de e-mail já enviados.
SECRET_KEY=troque-por-uma-chave-longa
# Banco de dados. Produção: PostgreSQL do Neon (postgresql://usuario:senha@host/banco?sslmode=require).
# No seu computador: MySQL, como abaixo.
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/marketplace?charset=utf8mb4
# Endereço oficial do site (links dos e-mails, Google e redirecionamento do endereço do Render). Obrigatório em produção.
SITE_URL=
# production liga as proteções de produção fora do Render (no Render é automático)
APP_ENV=
# 1 = cookie só em HTTPS mesmo fora da produção
COOKIE_SECURE=

# ---------- Painel ----------
# Endereço secreto do painel (ex.: /painel-k7x92qf). Só você deve saber.
ADMIN_PATH=/admin
# Senha do admin criado no primeiro init-db (sem ela, uma senha aleatória aparece uma vez no log)
ADMIN_PASSWORD=
# Sessão do painel cai depois de X minutos sem usar (padrão 120) ou X horas depois do login (padrão 12)
ADMIN_INATIVO_MIN=120
ADMIN_SESSAO_MAX_H=12
# Sessão do cliente na loja: entra de novo depois de X dias do login (padrão 30)
CLIENTE_SESSAO_MAX_DIAS=30
# Só em emergência (perdeu o celular da verificação em duas etapas): 1, entre, ajuste e apague a variável
ADMIN_2FA_DESLIGADO=

# ---------- E-mail ----------
# Preencha UMA das opções. Sem nenhuma, os e-mails aparecem só no terminal (bom para testar).
MAIL_FROM=Marketplace B2B <nao-responda@seudominio.com.br>
# Opção 1: Brevo pela API (recomendada no Render grátis, que bloqueia as portas de SMTP)
BREVO_API_KEY=
# Opção 2: Resend (resend.com)
RESEND_API_KEY=
# Opção 3: SMTP, ex.: Gmail com "senha de app"
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Quem recebe o aviso quando o site dá erro ou o banco passa de 80% (separe com vírgula)
ALERTA_EMAIL=

# ---------- Pagamento ----------
# Pix com QR estático (usado quando a Efí não está configurada)
PIX_KEY=
PIX_NAME=Marketplace B2B
PIX_CITY=SAO PAULO
# Pix, boleto e cartão de crédito pela Efí, com baixa automática. O cartão liga em Painel > Financeiro,
# depois que a Efí libera o cartão na conta. O certificado .p12 vai em Secret Files no Render;
# a variável é o caminho (ex.: /etc/secrets/efi.p12).
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICADO=
EFI_CERTIFICADO_SENHA=
EFI_CHAVE_PIX=
# 1 = ambiente de testes da Efí (sem dinheiro de verdade)
EFI_SANDBOX=

# ---------- Nota fiscal (NF-e) ----------
# sefaz = direto na SEFAZ (padrão) | api = provedor de emissão (com NFE_API_URL e NFE_API_TOKEN)
NFE_PROVEDOR=sefaz
# Certificado digital A1 da empresa (.pfx em Secret Files; a variável é o caminho, ex.: /etc/secrets/certificado.pfx)
NFE_CERTIFICADO=
NFE_CERTIFICADO_SENHA=
NFE_API_URL=
NFE_API_TOKEN=

# ---------- Backup e tarefas automáticas ----------
# Senha que protege o backup semanal enviado por e-mail
BACKUP_SENHA=
# Código que o GitHub Actions usa para pedir o backup toda segunda (o mesmo valor vai nos segredos do GitHub)
TAREFAS_TOKEN=
# Espaço do plano do banco em MB (padrão 512, o Neon grátis). Acima de 80%, os donos recebem um e-mail.
LIMITE_BANCO_MB=512

# ---------- Frete (Melhor Envio: Correios e transportadoras) ----------
# Token de acesso gerado no painel do Melhor Envio. Permissões: shipping-calculate (cotação) e, para comprar
# etiquetas pelo pedido, cart-read, cart-write, shipping-checkout, shipping-generate, shipping-print,
# shipping-tracking e shipping-cancel. Sem token, o frete usa só a tabela própria. Ligar: Painel > Frete.
MELHOR_ENVIO_TOKEN=
# E-mail técnico que vai em cada chamada (o Melhor Envio pede um contato)
MELHOR_ENVIO_CONTATO=
# 1 = ambiente de testes (sandbox.melhorenvio.com.br, com token gerado lá)
MELHOR_ENVIO_SANDBOX=
# Opcional: secret do aplicativo do Melhor Envio (Integrações > Área Dev), para receber os avisos (webhook) em
# /webhooks/melhor-envio. Só funciona com etiquetas compradas pelo token desse aplicativo. Sem ele, o rastreio é
# conferido pela tarefa automática do GitHub (algumas vezes por dia).
MELHOR_ENVIO_SECRET=

# ---------- Atendimento e contato ----------
# Botões de WhatsApp (só números, com país e DDD, ex.: 5511999998888)
WHATSAPP_NUMBER=
# Atendente virtual com IA (Claude). Sem a chave, o chat não aparece no site.
ANTHROPIC_API_KEY=
ATENDENTE_MODELO=claude-opus-5-5
# Mensagens por dia na loja toda (protege a conta de gastos inesperados)
ATENDENTE_LIMITE_DIA=1000
# Confirmação do celular por SMS (Twilio Verify, opcional e pago). Sem as três, fica desligada.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ---------- Outros ----------
# Consulta do CNPJ na Receita (BrasilAPI) no cadastro de empresas. 0 desliga.
CONSULTA_CNPJ=1
# Google Search Console: só o valor de content="..." da tag HTML
GOOGLE_SITE_VERIFICATION=
